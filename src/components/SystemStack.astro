---
// Hero visual: one AI system drawn as five stacked layers. Decorative, with an accessible text summary.
import { heroSystems, heroLayers } from '../data/home';
interface Props { controls?: boolean }
const { controls = true } = Astro.props;

const ramp = ['#3A8DD8', '#1FB9A8', '#2FD4B0', '#4DF2B0', '#B8FFE4'];
const rgba = (h: string, a: number) => `rgba(${parseInt(h.slice(1, 3), 16)},${parseInt(h.slice(3, 5), 16)},${parseInt(h.slice(5, 7), 16)},${a})`;
const kinds = ['input', 'model', 'compute', 'api', 'product'];
const sysKeys = Object.keys(heroSystems) as (keyof typeof heroSystems)[];

// Glyphs on the first (data) layer, one set per example system.
const cells = Array.from({ length: 36 }, (_, i) => ({ r: Math.floor(i / 6), c: i % 6 }));
const visionCols = ['#B8FFE4', '#4DF2B0', '#1FB9A8', '#1B6E8A', '#3A8DD8'];
const glyph = {
  vision: cells.map(({ r, c }) => ({ bg: visionCols[Math.min(4, Math.round(Math.min(1, r * 0.18 + Math.abs(c - 2.5) * 0.12) * 4))], op: 0.95, h: 1 })),
  llm: cells.map(({ r, c }) => ({ bg: c < [6, 4, 5, 3, 6, 2][r] ? (r === 0 ? '#E8F2EE' : '#3E6F62') : 'transparent', op: 1, h: 0.45 })),
  speech: cells.map(({ r, c }) => { const a = [0.2, 0.5, 0.9, 0.6, 1, 0.35][c] * [0.6, 1, 0.8, 0.4, 0.9, 0.5][r]; return { bg: '#1FB9A8', op: 0.4 + a * 0.6, h: Math.max(0.15, a) }; }),
};
const top = (i: number) => `${((140 + i * 84) / 620 * 100).toFixed(2)}%`;
---
<div class="ss" data-ss data-sys="vision" data-cursor-mode="cross">
  <div class="ss-stage" role="img" aria-label="Illustration of one AI system as five stacked layers — data in, model, compute, API and product — for vision, LLM or speech projects.">
    <div class="ss-tilt">
      <div class="ss-dots"></div>
      <div class="ss-axis"></div>
      {heroLayers.map((_, i) => (
        <div class="ss-layer" style={`top:${top(i)};animation-delay:${0.15 + i * 0.14}s`}>
          <div class="ss-float" style={`animation-delay:${-i * 0.9}s`}>
            <div class="ss-plane">
              <div class="ss-fill" style={`--c:${ramp[i]};--f:${rgba(ramp[i], i === 0 || i === 4 ? 0.1 : 0.08)};--fo:${rgba(ramp[i], 0.32)};--g:${rgba(ramp[i], i === 0 ? 0.25 : 0.15)};animation-delay:${1.45 + i * 0.66}s`}></div>
              {kinds[i] === 'input' && sysKeys.map((k) => (
                <div class={`ss-glyph-set g-${k}`}>
                  <div class="ss-glyph">
                    {glyph[k].map((g) => <span style={`background:${g.bg};opacity:${g.op};transform:scaleY(${g.h})`}></span>)}
                  </div>
                </div>
              ))}
              {kinds[i] === 'model' && <div class="ss-model">{Array.from({ length: 9 }, () => <span></span>)}</div>}
              {kinds[i] === 'compute' && <div class="ss-compute">{Array.from({ length: 16 }, () => <span></span>)}</div>}
              {kinds[i] === 'api' && <div class="ss-api"><span></span><span></span><span></span></div>}
              {kinds[i] === 'product' && <div class="ss-product"><i></i><i></i><i></i><i></i></div>}
            </div>
          </div>
        </div>
      ))}
      <span class="ss-packet p2" aria-hidden="true"></span>
      <span class="ss-packet" aria-hidden="true"></span>
      {heroLayers.map((name, i) => (
        <div class="ss-label" style={`top:${top(i)};--c:${ramp[i]};animation-delay:${0.7 + i * 0.12}s`}>
          <span class="lead"></span>
          <div>
            <b><span class="n mono">L{i + 1}</span>{name}</b>
            {sysKeys.map((k) => <small class={`ss-tech t-${k}`}>{heroSystems[k].tech[i]}</small>)}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="ss-top">
    <span class="ss-status"><span class="dot"></span>deployed · 200 OK<span class="cur" aria-hidden="true"></span></span>
    {controls && (
      <div class="ss-tabs" role="group" aria-label="Example system">
        {sysKeys.map((k, i) => <button type="button" data-sys={k} aria-pressed={i === 0 ? 'true' : 'false'}>{heroSystems[k].label}</button>)}
      </div>
    )}
  </div>
  <div class="ss-foot">
    {sysKeys.map((k) => <span class={`ss-route r-${k}`}>{heroSystems[k].route}</span>)}
    <span style="color:#7F948D">fig. 00 — one engineer, every layer</span>
  </div>
</div>
