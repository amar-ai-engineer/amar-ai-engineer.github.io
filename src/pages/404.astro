---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Amar Ismail" description="This page doesn't exist. Explore AI services, case studies or start a project." noindex>
  <section class="pad" style="overflow:hidden">
    <div class="aurora" aria-hidden="true" style="right:5%;top:10%;width:480px;height:520px;opacity:.45"></div>
    <div class="wrap" style="position:relative;display:flex;flex-direction:column;gap:24px;min-height:50vh;justify-content:center">
      <p class="kicker">404 · signal lost</p>
      <h1 class="display d1">This page didn’t <span class="hl">ship.</span></h1>
      <p class="lede">The link may be old or mistyped. Here’s where to go instead:</p>
      <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
        <a class="btn" href="/">Home <span class="arr" aria-hidden="true">→</span></a>
        <a class="link-u" href="/services/">Services</a>
        <a class="link-u" href="/work/">Case studies</a>
        <a class="link-u" href="/contact/">Start a project</a>
      </div>
    </div>
  </section>
</Base>
